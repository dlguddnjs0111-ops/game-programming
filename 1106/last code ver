/* ============================================================
 *  main
 * ============================================================ */
int main(void)
{
    Game g;
    int sel;
    
   

    srand((unsigned)time(NULL));
    setup_console();                 /* [업9]  */
    hide_cursor();                   /* [업10] */
    splash_screen();                 /* [업12] */

    while (1)                        /* [업38] 게임이 끝나도 메뉴로 돌아와 다시 하기 */
    {
        sel = main_menu();           /* [업13] */
        if (sel == 0) {                                  /* 새 게임 */
            int diff = select_difficulty();
            if (diff < 0) continue;
            new_game(&g, diff);
            run_game(&g);
        }
        else if (sel == 1) {                             /* 이어하기 */
            if (load_game(&g)) run_game(&g);
            else {
                show_msg(C_RED, "저장된 게임이 없습니다.");
                snd_error();
                Sleep(1000);
            }
        }
        else if (sel == 2) rules_screen();               /* 게임 방법 */
        else if (sel == 3) record_screen();              /* 전적 */
        else if (sel == 4) sound_on = !sound_on;         /* 소리 */
        else {                                           /* 종료 */
            system("cls");
            print_at(25, 12, C_CYAN, "플레이해 주셔서 감사합니다!");
            Sleep(1000);
            set_color(C_GRAY);
            return 0;
        }
    }
}

/* ============================================================
 *  콘솔 기본 기능
 * ============================================================ */
void gotoxy(int x, int y)
{
    COORD pos = { (SHORT)(x - 1), (SHORT)(y - 1) };
    SetConsoleCursorPosition(GetStdHandle(STD_OUTPUT_HANDLE), pos);
}

/* [업11] 글자 색 바꾸기 */
void set_color(int color)
{
    SetConsoleTextAttribute(GetStdHandle(STD_OUTPUT_HANDLE), (WORD)color);
}

/* [업10] 깜빡이는 커서 숨기기 */
void hide_cursor(void)
{
    CONSOLE_CURSOR_INFO ci;
    ci.dwSize = 1;
    ci.bVisible = FALSE;
    SetConsoleCursorInfo(GetStdHandle(STD_OUTPUT_HANDLE), &ci);
}

/* [업9] 창 제목, 창 크기 설정 */
void setup_console(void)
{
    SetConsoleTitleA("100을 넘어라 : 아이템 카드 배틀");
    system("mode con cols=80 lines=32");
}

/* [업3] 한 줄 지우기 (잔상 제거) */
void clear_line(int y)
{
    gotoxy(1, y);
    printf("%79s", "");
}

void print_at(int x, int y, int color, const char *fmt, ...)
{
    va_list ap;
    gotoxy(x, y);
    set_color(color);
    va_start(ap, fmt);
    vprintf(fmt, ap);
    va_end(ap);
    set_color(C_GRAY);
}

/* 맨 아래 메시지 줄 */
void show_msg(int color, const char *fmt, ...)
{
    va_list ap;
    clear_line(29);
    gotoxy(3, 29);
    set_color(color);
    va_start(ap, fmt);
    vprintf(fmt, ap);
    va_end(ap);
    set_color(C_GRAY);
}

/* [업16] 키 입력 (방향키는 1000+코드로 돌려줌) */
int get_key(void)
{
    int c = _getch();                       /* [업6] getch -> _getch */
    if (c == 0 || c == 224)
        return 1000 + _getch();
    return c;
}

void press_any_key(int y)
{
    print_at(3, y, C_DARK, "아무 키나 누르세요...");
    get_key();
}

/* [업13] 방향키 메뉴 (공용 함수) - 선택한 번호 반환, ESC는 -1 */
int menu_select(int x, int y, const char *items[], int n, int start)
{
    int sel = start, i, key;
    while (1)
    {
        for (i = 0; i < n; i++) {
            if (i == sel) print_at(x, y + i * 2, C_YELLOW, "▶ %-30s", items[i]);
            else          print_at(x, y + i * 2, C_GRAY,   "   %-30s", items[i]);
        }
        key = get_key();
        if (key == KEY_UP)        { sel = (sel + n - 1) % n; snd_move(); }
        else if (key == KEY_DOWN) { sel = (sel + 1) % n;     snd_move(); }
        else if (key == KEY_ENTER){ snd_select(); return sel; }
        else if (key == KEY_ESC)  return -1;
    }
}

