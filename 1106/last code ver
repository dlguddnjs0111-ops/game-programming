        print_at(30, 9, C_WHITE, "사용자가 이겼습니다!");
    } else if (winner == COM) {
        print_at(15, 3, color, " #   #  ###  #   #     #      ###   ####  #####");
        print_at(15, 4, color, "  # #  #   # #   #     #     #   # #      #    ");
        print_at(15, 5, color, "   #   #   # #   #     #     #   #  ###   #### ");
        print_at(15, 6, color, "   #   #   # #   #     #     #   #     #  #    ");
