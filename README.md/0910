game-programming 2026

#include <stdio.h>

void draw_square(int size);

int main(void)
{
    int n;
    printf("사각형 그리기\n\n");
    printf("사각형의 길이(최대37)를\n");
    printf("입력하고 Enter> ");
    scanf("%d", &n); // 숫자를 1개만 입력받습니다.
    
    draw_square(n);
    
    return 0;
}

void draw_square(int size)
{
    int i, j;
    unsigned char a = 0xa6;
    unsigned char b[7]; 
    
    for(i = 1; i < 7; i++)
        b[i] = 0xa0 + i;
        
    // 윗변 그리기
    printf("%c%c", a, b[3]);
    for(i = 0; i < size; i++)
        printf("%c%c", a, b[1]);
    printf("%c%c\n", a, b[4]);
    
    // 중간 부분 (양쪽 변과 내부 공간) 그리기
    for(i = 0; i < size; i++)
    {
        printf("%c%c", a, b[2]); // 왼쪽 변
        
        for(j = 0; j < size; j++)
            printf(" "); // ★ 띄어쓰기 딱 1개 (어긋남 방지) ★
            
        printf("%c%c\n", a, b[2]); // 오른쪽 변
    }
    
    // 아랫변 그리기
    printf("%c%c", a, b[6]);
    for(i = 0; i < size; i++)
        printf("%c%c", a, b[1]);
    printf("%c%c\n", a, b[5]);
}
