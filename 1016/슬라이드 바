#include <stdio.h>
#include <stdlib.h>
#include <conio.h>
#include <windows.h>

void draw_horizontal_slide(int x, int y, int length, char *s);
void draw_vertical_slide(int x, int y, int length, char *s);
void draw_rectangle(int c, int r);
void move_arrow_key(int key, int *x1, int *y1, int x_b, int y_b);
void gotoxy(int x, int y);
void hide_cursor(); 

int main(void)
{
    // 한글 특수문자 깨짐 방지
    system("chcp 949 > nul"); 
    
    char *slide = "■";
    int key; 
    int x = 1, y = 1;
    int h_slide_length, v_slide_length;
    
    hide_cursor(); 

    printf("슬라이드바 표시\n\n");
    printf("수평 슬라이드바의 길이(최대 70)를 \n");
    printf("입력하고 Enter> ");
    scanf("%d", &h_slide_length);
    
    if(h_slide_length > 70) h_slide_length = 70;
    if(h_slide_length < 1) h_slide_length = 1;

    printf("수직 슬라이드바의 길이(최대 19)를 \n");
    printf("입력하고 Enter> ");
    scanf("%d", &v_slide_length);
    
    if(v_slide_length > 19) v_slide_length = 19;
    if(v_slide_length < 1) v_slide_length = 1;

    system("cls");

    do
    {
        draw_vertical_slide(1, y, v_slide_length, slide);
        draw_horizontal_slide(x, v_slide_length + 3, h_slide_length, slide);
        
        key = getch();
        
        if (key == 224 || key == -32) {
            key = getch(); 
        }
        
        move_arrow_key(key, &x, &y, h_slide_length, v_slide_length);
        
    } while(key != 27); 

    return 0;
}

// ★★★ 최후의 마개조: 얇게 그려지는 선들을 두 번씩 찍어서 물리적으로 크기를 넓혀버림 ★★★
void draw_rectangle(int c, int r)
{
    int i, j;
    unsigned char a = 0xa6;
    unsigned char b[7]; 
    
    for(i=1; i<7; i++)
        b[i] = 0xa0 + i;
        
    // 윗변: 모서리와 선을 두 번씩 그려서 공간 확보 (┌─ ── ── ┐)
    printf("%c%c%c%c", a, b[3], a, b[1]); 
    for(i=0; i<c; i++)
        printf("%c%c%c%c", a, b[1], a, b[1]); 
    printf("%c%c\n", a, b[4]); 
    
    // 중간 기둥: 왼쪽 벽 뒤에 빈칸을 하나 더 뚫고, 내부 공간도 2배로 확장
    for(i=0; i<r; i++)
    {
        printf("%c%c ", a, b[2]); // 왼쪽 벽(│) + 공백 1칸
        for(j=0; j<c; j++)
            printf("  ");         // 내부 공간 2배로 확장
        printf("%c%c\n", a, b[2]); // 오른쪽 벽(│)
    }
    
    // 아랫변: 윗변과 똑같이 두 번씩 그림 (└─ ── ── ┘)
    printf("%c%c%c%c", a, b[6], a, b[1]); 
    for(i=0; i<c; i++)
        printf("%c%c%c%c", a, b[1], a, b[1]); 
    printf("%c%c\n", a, b[5]); 
}

void draw_horizontal_slide(int x, int y, int length, char *s)
{
    int real_length = length / 2;
    gotoxy(1, y);
    draw_rectangle(real_length + 1, 1);
    gotoxy(x + 2, y + 1); // 이제 박스가 넉넉해져서 이 좌표에 완벽히 들어감!
    printf("%s", s);
    gotoxy(real_length * 2 + 2, y - 1);
    printf("%2d", x);
}

void draw_vertical_slide(int x, int y, int length, char *s)
{
    gotoxy(x, 1);
    draw_rectangle(1, length);
    gotoxy(x + 2, y + 1);
    printf("%s", s);
    gotoxy(x + 6, length + 1);
    printf("%2d", y);
}

void gotoxy(int x, int y)
{
    COORD Pos = {x - 1, y - 1};
    SetConsoleCursorPosition(GetStdHandle(STD_OUTPUT_HANDLE), Pos);
}

void move_arrow_key(int key, int *x1, int *y1, int x_b, int y_b)
{
    switch(key)
    {
        case 72: 
            *y1 = *y1 - 1;
            if (*y1 < 1) *y1 = 1; 
            break;
        case 75: 
            *x1 = *x1 - 1;
            if (*x1 < 1) *x1 = 1; 
            break;
        case 77: 
            *x1 = *x1 + 1;
            if (*x1 > x_b) *x1 = x_b; 
            break;
        case 80: 
            *y1 = *y1 + 1;
            if (*y1 > y_b) *y1 = y_b; 
            break;
        default:
            return;
    }
}

void hide_cursor()
{
    CONSOLE_CURSOR_INFO cursorInfo;
    cursorInfo.bVisible = FALSE; 
    cursorInfo.dwSize = 1;
    SetConsoleCursorInfo(GetStdHandle(STD_OUTPUT_HANDLE), &cursorInfo);
}
