#include <stdio.h>
#include <time.h>
#include <conio.h>
#include <stdlib.h>
#include <windows.h>

void intro_game(void);
void game_control(void);
int computer_number(int i, int com_array[]);
int user_number(int i, int user_array[]);
void number_display(int i, int com_array[], int user_array[], int sum);
void conclusion(int win);
void gotoxy(int x, int y);
void press_any_key(void);

int main(void)
{
	system("chcp 65001"); // [수정] 깃허브 및 최신 콘솔 한글 깨짐 완벽 방지
	srand((unsigned int)time(NULL)); // [수정] 경고(Warning) 방지를 위한 형변환 추가
	intro_game();
	game_control();
	return 0;
}

void intro_game(void)
{
	system("cls");
	printf("100을 넘어라 게임\n\n");
	printf("컴퓨터와 사용자가 번갈아가며\n");
	printf("숫자를 입력하되 1~10사이의 \n");
	printf("중복되지 않는 숫자를 입력하여 \n\n");
	printf("최초로 100을 넘기면 승자가 됩니다. \n\n");
	printf("컴퓨터가 먼저 시작합니다. \n");
	printf("아무키나 누르면 시작합니다.");
	getch();
}

int computer_number(int i, int com_array[])
{
	int j, number;
	again:
	number = rand() % 10 + 1;
	for(j = 0; j < i; j += 1)
		if (com_array[j] == number)
			goto again;
	com_array[i] = number;
	return com_array[i];
}

int user_number(int i, int user_array[])
{
	int j, number;
	again:
	gotoxy(1, 7);
	// [수정] 안내 문구를 더 명확히 하고, 뒤에 공백을 넣어 이전 글씨 잔상을 지움
	printf("사용자 숫자 입력후 Enter (1~10) >           "); 
	gotoxy(35, 7); // 입력 커서 위치를 기호(>) 바로 뒤로 예쁘게 조정
	
	// [수정] 숫자가 아닌 문자(a, b 등)를 입력했을 때 무한루프에 빠지는 버그 방지
	if (scanf("%d", &number) != 1) {
		while (getchar() != '\n'); // 잘못 입력된 문자 버퍼 비우기
		gotoxy(1, 8);
		printf("잘못된 입력입니다. 숫자만 입력하세요!       \n");
		goto again;
	}

	// [수정] 사용자가 1~10 범위를 벗어나는 숫자를 내는 꼼수 방지
	if (number < 1 || number > 10) {
		gotoxy(1, 8);
		printf("1에서 10 사이의 숫자만 낼 수 있습니다!      \n");
		goto again;
	}

	// 기존 중복 검사
	for(j = 0; j < i; j += 1) {
		if (user_array[j] == number)
		{
			gotoxy(1, 8);
			printf("이미 사용한 중복된 숫자입니다!              \n");
			goto again;
		}
	}
	
	// [수정] 정상적으로 입력했을 경우, 8번째 줄의 에러 메시지를 깨끗하게 지워줌
	gotoxy(1, 8);
	printf("                                            \n");
	
	user_array[i] = number;
	return user_array[i];
}

void number_display(int i, int com_array[], int user_array[], int sum)
{
	int j;
	gotoxy(1, 2);
	printf("컴퓨터 숫자 : ");
	for(j = 0; j <= i; j += 1)
		printf("%2d ", com_array[j]);
		
	gotoxy(1, 3);
	printf("사용자 숫자 : ");
	for(j = 0; j <= i; j += 1)
		if (user_array[j] == 0)
			continue;
		else
			printf("%2d ", user_array[j]);
			
	gotoxy(1, 5);
	printf("현재 합계 : %3d\n", sum);
}

void conclusion(int check)
{
	system("cls"); // [수정] 마지막 결과 출력 시 화면을 깨끗하게 정리
	gotoxy(1, 2);
	if (check == 1)
		printf("컴퓨터가 이겼습니다! \n");
	else
		printf("사용자가 이겼습니다! \n");
}

void press_any_key(void)
{
	gotoxy(1, 10);
	printf("아무키나 누르시오..                 ");
	getch();
}

void game_control(void)
{
	int max = 100;
	int com_array[10] = {0}, user_array[10] = {0}, number;
	int i, sum = 0, win = 0; // [수정] win 변수가 비어있지 않도록 0으로 초기화
	
	for(i = 0; i < 10; i += 1)
	{
		system("cls");
		number = computer_number(i, com_array);
		sum += number;
		number_display(i, com_array, user_array, sum);
		if (max < sum)
		{
			win = 1;
			break;
		}
		
		number = user_number(i, user_array);
		sum += number;
		number_display(i, com_array, user_array, sum);
		if (max < sum)
		{
			win = 2;
			break;
		}
		press_any_key();
	}
	conclusion(win);
}

void gotoxy(int x, int y)
{
   COORD Pos = {x - 1, y - 1};
   SetConsoleCursorPosition(GetStdHandle(STD_OUTPUT_HANDLE), Pos);
}
